<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nats_navy</item>
        <item name="colorPrimaryDark">@color/nats_night</item>
        <item name="colorAccent">@color/nats_gold</item>
        <item name="android:statusBarColor">@color/nats_navy</item>
        <item name="android:navigationBarColor">@color/nats_navy</item>
        <item name="android:windowBackground">@color/nats_night</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/nats_navy</item>
        <item name="android:navigationBarColor">@color/nats_navy</item>
    </style>

    <!-- Layar pembuka (Android 12+ SplashScreen API, kompatibel mundur via core-splashscreen) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nats_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/nats_night</item>
    </style>
</resources>
